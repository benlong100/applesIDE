tools/acx-mac-*
tools/merlin32
.DS_Store
notes/

# Generated on every build from lang/<code>.txt and tools/genhelp.py.
# ZipEdit committed these for a while and they fell silently out of date --
# a help row was added to the generator, the checked-in copy was never
# regenerated, and every build after that shipped a blank line where the
# command should have been.
src/lang.S
src/lang_*.S
src/helpdata.S
src/tokens.S
build/bench/

# Tokenised Applesoft under tests/cc. The .bas.txt beside each one is the
# source of truth -- tests/cc.sh tokenises into build/bench and never reads
# these. The rest are real programs off a distribution disk, kept locally as
# compile fixtures and not ours to redistribute.
tests/cc/*.bas
