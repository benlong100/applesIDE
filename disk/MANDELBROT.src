10 REM MANDELBROT -- THE INNER FOR IS WHERE THE TIME GOES
20 TEXT : HOME : INVERSE
30 VTAB 2 : HTAB 11 : PRINT " THE MANDELBROT SET "
40 NORMAL : VTAB 4 : HTAB 6 : PRINT "1600 POINTS, 15 ITERATIONS EACH"
50 FOR W = 1 TO 600 : NEXT W
60 GR : DEF FN S(P) = (P - 20) / 13
70 FOR Y = 0 TO 39
80 CI = FN S(Y)
90 FOR X = 0 TO 39
100 CR = FN S(X) - 0.6 : ZR = 0 : ZI = 0 : N = 0
110 FOR I = 1 TO 15
120 T = ZR * ZR - ZI * ZI + CR
130 ZI = 2 * ZR * ZI + CI : ZR = T
140 IF ZR * ZR + ZI * ZI > 4 THEN N = I : I = 15
150 NEXT I
160 COLOR= N : PLOT X,Y
170 NEXT X
180 NEXT Y
190 VTAB 22 : PRINT "SLOW? NOW RUN IT COMPILED.";
200 GET K$ : TEXT : HOME
